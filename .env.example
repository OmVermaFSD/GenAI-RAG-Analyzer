# Application Settings
APP_NAME="DocuMind AI – RAG Knowledge Retrieval Platform"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Ollama LLM Configuration
# Supported models: llama3, mistral, deepseek
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Vector Store & Document Directories
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# SQLite Database
SQLITE_DB_URL=sqlite:///./data/app.db

# JWT Security
JWT_SECRET_KEY=super-secret-key-change-in-production-123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
